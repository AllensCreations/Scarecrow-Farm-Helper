{
  "format_version": "1.8.0",
  "animations": {
    "animation.scarecrow.idle": {
      "loop": true,
      "animation_length": 3.0,
      "bones": {
        "head": {
          "rotation": [
            "math.sin(query.anim_time * 60) * 2.0",
            "math.sin(query.anim_time * 30) * 5.0",
            "math.cos(query.anim_time * 60) * 1.5"
          ]
        },
        "body": {
          "position": [
            0,
            "math.sin(query.anim_time * 120) * 0.15",
            0
          ]
        },
        "left_arm": {
          "rotation": [
            0,
            0,
            "10.0 + math.sin(query.anim_time * 90) * 3.0"
          ]
        },
        "right_arm": {
          "rotation": [
            0,
            0,
            "-10.0 - math.sin(query.anim_time * 90) * 3.0"
          ]
        }
      }
    },
    "animation.scarecrow.walk": {
      "loop": true,
      "anim_time_update": "query.modified_distance_moved",
      "bones": {
        "body": {
          "rotation": [
            0,
            0,
            "math.cos(query.modified_distance_moved * 38.17) * 7.0"
          ],
          "position": [
            0,
            "math.abs(math.sin(query.modified_distance_moved * 38.17)) * 0.6",
            0
          ]
        },
        "head": {
          "rotation": [
            "math.abs(math.sin(query.modified_distance_moved * 38.17)) * 4.0",
            0,
            "-math.cos(query.modified_distance_moved * 38.17) * 5.0"
          ]
        },
        "left_arm": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 30.0",
            0,
            "15.0 + math.sin(query.modified_distance_moved * 38.17) * 5.0"
          ]
        },
        "right_arm": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 30.0",
            0,
            "-15.0 - math.sin(query.modified_distance_moved * 38.17) * 5.0"
          ]
        },
        "left_leg": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 40.0",
            0,
            0
          ]
        },
        "right_leg": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 40.0",
            0,
            0
          ]
        }
      }
    },
    "animation.scarecrow.harvest": {
      "loop": "hold_on_last_frame",
      "animation_length": 1.0,
      "bones": {
        "body": {
          "rotation": {
            "0.0": [0, 0, 0],
            "0.3": [25, 0, 0],
            "0.6": [30, 0, 0],
            "1.0": [0, 0, 0]
          }
        },
        "head": {
          "rotation": {
            "0.0": [0, 0, 0],
            "0.3": [15, 0, 0],
            "0.6": [20, 0, 0],
            "1.0": [0, 0, 0]
          }
        },
        "left_arm": {
          "rotation": {
            "0.0": [0, 0, 10],
            "0.3": [-50, 15, 0],
            "0.6": [-65, 20, 0],
            "1.0": [0, 0, 10]
          }
        },
        "right_arm": {
          "rotation": {
            "0.0": [0, 0, -10],
            "0.3": [-50, -15, 0],
            "0.6": [-65, -20, 0],
            "1.0": [0, 0, -10]
          }
        }
      }
    },
    "animation.scarecrow.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0
          ]
        }
      }
    }
  }
}
