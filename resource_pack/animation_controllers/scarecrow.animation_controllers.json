{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.scarecrow.movement": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "sit": "query.skin_id == 1"
            },
            {
              "walk": "query.ground_speed > 0.05 && query.skin_id != 1"
            }
          ],
          "blend_transition": 0.3
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "sit": "query.skin_id == 1"
            },
            {
              "idle": "query.ground_speed <= 0.05"
            }
          ],
          "blend_transition": 0.2
        },
        "sit": {
          "animations": [
            "sit"
          ],
          "transitions": [
            {
              "idle": "query.skin_id == 0"
            }
          ],
          "blend_transition": 0.3
        }
      }
    },
    "controller.animation.scarecrow.jump": {
      "initial_state": "on_ground",
      "states": {
        "on_ground": {
          "transitions": [
            {
              "in_air": "!query.is_on_ground"
            }
          ]
        },
        "in_air": {
          "sound_effects": [
            "jump"
          ],
          "transitions": [
            {
              "landing": "query.is_on_ground"
            }
          ]
        },
        "landing": {
          "sound_effects": [
            "land"
          ],
          "transitions": [
            {
              "on_ground": "query.is_on_ground"
            },
            {
              "in_air": "!query.is_on_ground"
            }
          ]
        }
      }
    }
  }
}
