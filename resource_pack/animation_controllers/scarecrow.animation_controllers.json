{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.scarecrow.movement": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "walk": "query.modified_distance_moved"
            }
          ],
          "blend_transition": 0.2
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "idle": "!query.modified_distance_moved"
            }
          ],
          "blend_transition": 0.2
        }
      }
    }
  }
}
