{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.scarecrow.movement": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            { "sit": "query.is_sitting" },
            { "walk": "query.modified_distance_moved" }
          ],
          "blend_transition": 0.2
        },
        "walk": {
          "animations": ["walk"],
          "transitions": [
            { "sit": "query.is_sitting" },
            { "idle": "!query.modified_distance_moved" }
          ],
          "blend_transition": 0.2
        },
        "sit": {
          "animations": ["sit"],
          "transitions": [
            { "walk": "query.modified_distance_moved" },
            { "idle": "!query.is_sitting" }
          ],
          "blend_transition": 0.3
        }
      }
    }
  }
}
